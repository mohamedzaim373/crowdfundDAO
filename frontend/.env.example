VITE_CORE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GOVERNANCE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat Local
# Bloc de deploiement du Core : point de depart des recherches d evenements
# (compteur de dons). Ecrit par scripts/deploy.ts ; 0 = depuis le debut.
VITE_DEPLOYMENT_BLOCK=0
# ipfs.io et dweb.link renvoient 429 depuis un réseau partagé.
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Jeton Pinata (Bearer JWT) pour publier les fiches de campagne depuis le
# formulaire. Laisser vide = le formulaire redemande un CID deja publie.
# ATTENTION : ce jeton finit en clair dans le bundle JS. Demo locale
# uniquement ; limitez la cle aux permissions pinFileToIPFS et pinJSONToIPFS.
VITE_PINATA_JWT=
