# Pass these as process environment variables for Sepolia (see README).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
TREASURY_OWNERS=0xOWNER_ONE,0xOWNER_TWO,0xOWNER_THREE

# Deployment defaults (optional)
TOKEN_RATE=100
VOTING_PERIOD_BLOCKS=20
EXECUTION_DELAY_BLOCKS=5
QUORUM_BPS=2000
TREASURY_LARGE_WITHDRAWAL_WEI=1000000000000000000
